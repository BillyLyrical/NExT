#!/usr/bin/env perl

use strict;
use warnings;
use Getopt::Long;
use Pod::Usage;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Data::NExT;
use Data::NExT::Util qw(check_refs);

my %opts = (
    file_arg   => '',
    verbose    => 0,
    strict_ref => 0,
    help       => 0,
    version    => 0,
);

GetOptions(
    'f|file=s'       => \$opts{file_arg},
    'version'        => \$opts{version},
    'V|verbose'      => \$opts{verbose},
    'strict-refs'    => \$opts{strict_ref},
    'h|help'         => \$opts{help},
) or pod2usage(2);

if ($opts{help}) {
    pod2usage(-verbose => 2);
}

if ($opts{version}) {
    print "nxt-validate " . Data::NExT->VERSION . "\n";
    exit 0;
}

my $file = $opts{file_arg} || shift @ARGV;
unless ($file && -f $file) {
    warn "Error: no input file\n";
    exit 1;
}

open my $fh, '<', $file or die "Cannot open '$file': $!\n";
my $input = do { local $/; <$fh> };
close $fh;

my $tree = Data::NExT::parse($input);

if ($Data::NExT::ERROR) {
    warn "FAIL: $file: $Data::NExT::ERROR\n";
    exit 1;
}

# Symbol reference checking
my $refs = check_refs($tree);
my $had_issues = 0;

for my $w (@{$refs->{warnings}}) {
    if ($opts{strict_ref}) {
        warn "ERROR: $file: $w\n";
        $had_issues = 1;
    } else {
        warn "WARN: $file: $w\n" if $opts{verbose};
    }
}

for my $e (@{$refs->{errors}}) {
    warn "ERROR: $file: $e\n";
    $had_issues = 1;
}

if ($had_issues) {
    exit 1;
}

if ($opts{verbose}) {
    my $count = scalar @$tree;
    print "OK: $file ($count top-level noun" . ($count == 1 ? '' : 's') . ")\n";
    for my $node (@$tree) {
        for my $key (keys %$node) {
            if (ref $node->{$key} eq 'HASH') {
                my $content = $node->{$key};
                my @adjs = grep { ref $content->{$_} ne 'HASH' } keys %$content;
                my @nouns = grep { ref $content->{$_} eq 'HASH' } keys %$content;
                printf "  %s [%d adj, %d children]\n", $key, scalar @adjs, scalar @nouns;
            }
        }
    }
}

exit 0;

__END__

=head1 NAME

nxt-validate - Validate NExT files

=head1 SYNOPSIS

  nxt-validate [options] file.nx

  Options:
    -f, --file FILE     Input file (alternative to positional arg)
    -V, --verbose       Show parse results and warnings
    --strict-refs       Error on undefined symbols (single-occurrence)
    -v, --version       Show version
    -h, --help          Show this help

=head1 DESCRIPTION

nxt-validate checks that a NExT file parses without errors.
Exits 0 on success, 1 on failure. Designed for CI/CD pipelines
and pre-commit hooks.

=head1 EXAMPLES

  nxt-validate config.nx && echo "valid"
  nxt-validate -V config.nx              # verbose output
  nxt-validate *.nx                      # validate all files

