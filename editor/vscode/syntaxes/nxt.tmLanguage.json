{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NExT",
  "scopeName": "source.nxt",
  "patterns": [
    { "include": "#comment" },
    { "include": "#noun" },
    { "include": "#adj" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#symbol" },
    { "include": "#bracket" },
    { "include": "#template" }
  ],
  "repository": {
    "comment": {
      "pattern": "#.*$",
      "name": "comment.line.number-sign.nxt"
    },
    "noun": {
      "pattern": "\\b[A-Z][a-zA-Z0-9_]*\\b",
      "name": "entity.name.type.nxt"
    },
    "adj": {
      "pattern": "\\b[a-z][a-zA-Z0-_-]*\\b",
      "name": "variable.other.nxt"
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.nxt",
          "patterns": [
            {
              "match": "\\\\[nrt\\\\\"]",
              "name": "constant.character.escape.nxt"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b[0-9]+\\.[0-9]+\\b",
          "name": "constant.numeric.float.nxt"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.nxt"
        }
      ]
    },
    "boolean": {
      "pattern": "\\b(true|false)\\b",
      "name": "constant.language.boolean.nxt"
    },
    "symbol": {
      "pattern": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.constant.nxt"
    },
    "bracket": {
      "pattern": "[\\[\\]\\(\\)]",
      "name": "punctuation.bracket.nxt"
    },
    "template": {
      "patterns": [
        {
          "match": "\\$\\{[^}]*\\}",
          "name": "variable.other.template.nxt"
        },
        {
          "match": "%[A-Z][a-zA-Z0-9_]*",
          "name": "keyword.control.directive.nxt"
        },
        {
          "match": "%[a-z][a-zA-Z0-_-]*",
          "name": "entity.name.function.nxt"
        }
      ]
    }
  }
}
