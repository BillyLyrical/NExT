# Deployment Configuration
# ------------------------
# Environment-aware deployment config using templates.
# Run: nxt-preprocess -D TARGET=production deploy.nxt > deploy.nx

Deploy[
    name("${APP_NAME:myapp}")
    target("${TARGET:staging}")
    version("${VERSION:latest}")
]

%Ifdef("PRODUCTION")
Infrastructure[
    provider("aws")
    region("ap-southeast-2")
    Cluster[
        name("${APP_NAME}-prod")
        min_nodes(3)
        max_nodes(10)
        instance_type("c5.large")
    ]
    Database[
        engine("aurora-postgresql")
        instance("db.r5.large")
        replicas(2)
        backup_retention(7)
    ]
    CDN[
        enabled(true)
        cache_ttl(86400)
    ]
    SSL[
        provider("letsencrypt")
        auto_renew(true)
    ]
]
%Else
Infrastructure[
    provider("docker")
    Cluster[
        name("${APP_NAME}-dev")
        min_nodes(1)
        max_nodes(2)
        instance_type("t3.medium")
    ]
    Database[
        engine("postgresql")
        instance("local")
        replicas(0)
        backup_retention(1)
    ]
    CDN[
        enabled(false)
    ]
    SSL[
        enabled(false)
    ]
]
%Endif

Monitoring[
    enabled(true)
    %Ifdef("PRODUCTION")
    alert_email("ops@example.com")
    dashboards(["cpu" "memory" "request_rate" "error_rate"])
    %Else
    dashboards(["cpu" "memory"])
    %Endif
]

HealthCheck[
    path("/health")
    interval(30)
    timeout(5)
    unhealthy_threshold(3)
]
